cmake_minimum_required(VERSION 3.15)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/DependencyChecks.cmake")
set(_fixture "${CMAKE_CURRENT_BINARY_DIR}/ariadne-submodule-checkout-test")
file(REMOVE_RECURSE "${_fixture}")
file(MAKE_DIRECTORY "${_fixture}")
function(_git DIRECTORY)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${DIRECTORY}" ${ARGN}
        OUTPUT_VARIABLE _out ERROR_VARIABLE _err RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "git -C ${DIRECTORY} ${ARGN}: ${_err}")
    endif()
endfunction()
set(_dep "${_fixture}/dependency")
file(MAKE_DIRECTORY "${_dep}")
_git("${_dep}" init -q)
_git("${_dep}" config user.email test@example.invalid)
_git("${_dep}" config user.name "Ariadne test")
file(WRITE "${_dep}/test.txt" "A\n")
_git("${_dep}" add test.txt)
_git("${_dep}" commit -qm A)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_dep}" rev-parse HEAD
    OUTPUT_VARIABLE _a OUTPUT_STRIP_TRAILING_WHITESPACE)
file(WRITE "${_dep}/test.txt" "B\n")
_git("${_dep}" add test.txt)
_git("${_dep}" commit -qm B)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_dep}" rev-parse HEAD
    OUTPUT_VARIABLE _b OUTPUT_STRIP_TRAILING_WHITESPACE)
set(_parent "${_fixture}/parent")
file(MAKE_DIRECTORY "${_parent}")
_git("${_parent}" init -q)
_git("${_parent}" config user.email test@example.invalid)
_git("${_parent}" config user.name "Ariadne test")
_git("${_parent}" config protocol.file.allow always)
_git("${_parent}" -c protocol.file.allow=always submodule add -q "${_dep}" ss/dep)
_git("${_parent}/ss/dep" checkout -q "${_a}")
_git("${_parent}" add .gitmodules ss/dep)
_git("${_parent}" commit -qm "Pin A")
_ariadne_checkout_submodule("${_parent}" "ss/dep" _checked)
_git("${_checked}" checkout -q "${_b}")
_ariadne_checkout_submodule("${_parent}" "ss/dep" _checked)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_checked}" rev-parse HEAD
    OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _head STREQUAL _b)
    message(FATAL_ERROR "Manual checkout was reset")
endif()
_git("${_parent}" add ss/dep)
_git("${_parent}" commit -qm "Pin B")
_git("${_checked}" checkout -q "${_a}")
_ariadne_checkout_submodule("${_parent}" "ss/dep" _checked)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_checked}" rev-parse HEAD
    OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _head STREQUAL _b)
    message(FATAL_ERROR "Changed gitlink did not synchronize")
endif()
_git("${_checked}" checkout -q "${_a}")
_ariadne_checkout_submodule("${_parent}" "ss/dep" _checked)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_checked}" rev-parse HEAD
    OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _head STREQUAL _a)
    message(FATAL_ERROR "Observed gitlink was not persisted")
endif()
file(REMOVE_RECURSE "${_fixture}")
message(STATUS "Submodule checkout synchronization passed")
