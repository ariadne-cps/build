include_guard(GLOBAL)

# Cache verified Gitlinks, not the entire Git index. Unrelated index updates
# cannot invalidate a previously checked constraint.
function(_ariadne_dependency_snapshot OUTPUT)
    set(_fingerprint "")
    foreach(_entry IN LISTS ARGN)
        string(REPLACE "|" ";" _parts "${_entry}")
        list(LENGTH _parts _count)
        if(NOT _count EQUAL 2)
            set(${OUTPUT} "" PARENT_SCOPE)
            return()
        endif()
        list(GET _parts 0 _repo)
        list(GET _parts 1 _submodule_path)
        if(NOT EXISTS "${_repo}/.git" OR NOT EXISTS "${_repo}/.gitmodules")
            set(${OUTPUT} "" PARENT_SCOPE)
            return()
        endif()
        get_gitlink_commit("${_repo}" "${_submodule_path}" _gitlink)
        file(SHA256 "${_repo}/.gitmodules" _mapping_hash)
        string(APPEND _fingerprint
            "${_repo}|${_mapping_hash}|${_submodule_path}|${_gitlink}\n")
    endforeach()
    string(SHA256 _hash "${_fingerprint}")
    set(${OUTPUT} "${_hash}" PARENT_SCOPE)
endfunction()

function(_ariadne_dependency_cache_matches KEY OUTPUT)
    set(${OUTPUT} FALSE PARENT_SCOPE)
    set(_cache "${CMAKE_BINARY_DIR}/.ariadne/dependency_checks/${KEY}.txt")
    if(NOT EXISTS "${_cache}")
        return()
    endif()
    file(STRINGS "${_cache}" _record)
    list(LENGTH _record _size)
    if(_size LESS 2)
        return()
    endif()
    list(GET _record 0 _expected)
    list(REMOVE_AT _record 0)
    _ariadne_dependency_snapshot(_actual ${_record})
    if(NOT _actual STREQUAL "" AND _actual STREQUAL _expected)
        set(${OUTPUT} TRUE PARENT_SCOPE)
    endif()
endfunction()

function(_ariadne_dependency_cache_record KEY)
    set(_entries ${ARGN})
    list(REMOVE_DUPLICATES _entries)
    _ariadne_dependency_snapshot(_hash ${_entries})
    if(_hash STREQUAL "")
        return()
    endif()
    set(_dir "${CMAKE_BINARY_DIR}/.ariadne/dependency_checks")
    file(MAKE_DIRECTORY "${_dir}")
    string(REPLACE ";" "\n" _lines "${_entries}")
    file(WRITE "${_dir}/${KEY}.txt" "${_hash}\n${_lines}\n")
endfunction()
